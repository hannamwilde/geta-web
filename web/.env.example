# Public base URL of the site, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.getadigital.com

# Sanity read token.
SANITY_API_TOKEN=

# Contact form delivery (app/api/contact/route.ts), sent via the SendGrid v3 API.
# The recipient address is NOT here — it lives in Sanity under Modals → Contact.
# CONTACT_FROM_EMAIL must be a verified sender in SendGrid.
SENDGRID_API_KEY=
CONTACT_FROM_EMAIL=noreply@getadigital.com
